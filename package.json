{
	"name": "sveltekiw",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"start": "node build",
		"pm2:start": "pm2 start ecosystem.config.cjs --env production",
		"pm2:stop": "pm2 stop ecosystem.config.cjs",
		"pm2:restart": "pm2 restart ecosystem.config.cjs --env production",
		"pm2:reload": "pm2 reload ecosystem.config.cjs --env production",
		"pm2:logs": "pm2 logs sveltekiw",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch"
	},
	"devDependencies": {
		"@sveltejs/adapter-node": "^5.5.4",
		"@sveltejs/kit": "^2.63.0",
		"@sveltejs/vite-plugin-svelte": "^7.1.2",
		"@tailwindcss/forms": "^0.5.11",
		"@tailwindcss/vite": "^4.3.0",
		"@types/mssql": "^12.3.0",
		"svelte": "^5.56.1",
		"svelte-check": "^4.6.0",
		"tailwindcss": "^4.3.0",
		"typescript": "^6.0.3",
		"vite": "^8.0.16"
	},
	"dependencies": {
		"@lucide/svelte": "^1.44.0",
		"clsx": "^2.1.1",
		"dotenv": "^17.4.2",
		"mssql": "^12.7.2",
		"pino": "^10.3.1",
		"pino-pretty": "^13.1.3",
		"tailwind-merge": "^3.6.0",
		"tailwind-variants": "^3.3.1",
		"tw-animate-css": "^1.4.0",
		"xlsx": "^0.18.5",
		"zod": "^4.6.2"
	}
}
