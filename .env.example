# APP
PORT=3670
HOST=0.0.0.0
LOG_LEVEL=info

# DATABASE UTAMA (kopi dari project existing)
DB_USER=sa
DB_PASSWORD=myPass123
DB_SERVER=127.0.0.1
DB_DATABASE=CP

# DATABASE LOGIN — dipakai untuk autentikasi (MenuCP.dbo.taUser)
# Jika tidak di-set, akan fallback ke DB_DATABASE (single-DB mode)
# Samakan dengan kiw: DB_DATABASE2 = MenuCP
DB_DATABASE2=MenuCP

MAINTENANCE_MODE=false

# TIMEOUT QUERY LAPORAN BESAR (ms) — Default 5 menit (300000 ms)
DB_REPORT_TIMEOUT=300000

# DATABASE BACKUP (server tidak live)
DB_BACKUP_USER=
DB_BACKUP_PASSWORD=
DB_BACKUP_SERVER=
DB_BACKUP_DATABASE=
DB_BACKUP_DATABASE2=
